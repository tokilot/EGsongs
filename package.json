{
  "name": "tabs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w server && tsc -p scripts && tsc -p test",
    "lint": "npm run lint -w web",
    "test": "vitest run",
    "fixtures": "node test/fetch-fixtures.ts",
    "e2e": "node test/e2e.ts",
    "e2e:songs": "node test/e2e-songs.ts",
    "soundfont": "node scripts/fetch-soundfont.ts"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "playwright-core": "1.64.0",
    "vitest": "5.0.3"
  }
}
